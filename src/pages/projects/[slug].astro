---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProjectDetail } from "@/components/portfolio/ProjectDetail";
import { getProjectBySlug, getProjectSlugs } from "@/lib/portfolio";

export function getStaticPaths() {
  return getProjectSlugs().map((slug) => ({ params: { slug } }));
}

const project = getProjectBySlug(Astro.params.slug ?? "");

if (!project) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={`${project.name} | 김민준 Portfolio`}
  description={project.summary}
  canonical={`https://minjoon.me/projects/${project.slug}/`}
>
  <script is:inline>
    try {
      const projectSlug = window.location.pathname.split("/").filter(Boolean).at(-1);
      if (sessionStorage.getItem("minjoon-store-entry") === projectSlug) {
        document.documentElement.dataset.storeJourney = "arriving";
        sessionStorage.removeItem("minjoon-store-entry");
      }
    } catch {
      // Storage may be unavailable in privacy-restricted browser modes.
    }
  </script>
  <main id="main">
    <ProjectDetail client:load project={project} />
  </main>
</BaseLayout>
